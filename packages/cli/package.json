{
  "name": "@cabo-game/cli",
  "version": "0.2.1",
  "type": "module",
  "bin": {
    "cabo": "./dist/main.js",
    "cabo-agent": "./dist/agent-main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "dev:agent": "tsx src/agent-main.ts"
  },
  "dependencies": {
    "@cabo-game/client-core": "workspace:*",
    "@cabo-game/shared": "workspace:*",
    "@colyseus/sdk": "0.18.2"
  }
}
