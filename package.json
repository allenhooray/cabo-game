{
  "name": "cabo-game",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @cabo/shared build && pnpm --filter @cabo/server dev",
    "dev:cli": "pnpm --filter @cabo/shared build && pnpm --filter @cabo/cli dev",
    "dev:agent": "pnpm --filter @cabo/shared build && pnpm --filter @cabo/cli dev:agent"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
